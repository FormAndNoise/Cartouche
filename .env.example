# Tarot Socket Board - Environment Variables
#
# This app is local-first and requires no secrets to run. The variables below
# are OPTIONAL development-time knobs. Copy this file to `.env` and adjust as
# needed:
#
#   cp .env.example .env
#
# Vite (the frontend dev server) only exposes variables prefixed with VITE_.
# Tauri-specific variables are prefixed with TAURI_.

# --- Frontend (Vite) ---

# Log level for the Vite dev server (info | warn | error | silent)
VITE_LOG_LEVEL=info

# --- Tauri (desktop shell) ---

# Host the Vite dev server binds to during `tauri dev`. Set to your LAN IP
# to test on a device; leave empty for localhost.
TAURI_DEV_HOST=

# --- Rust / Cargo ---

# Path to a custom WebView2 runtime dir (Windows only). Leave empty to use
# the system-installed Edge WebView2.
WEBVIEW2_BROWSER_EXECUTABLE_FOLDER=
